# Copy to .env.local and fill in. Never commit .env.local.

# --- Firebase web app (Firebase console > Project settings > General > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase service account (Project settings > Service accounts > Generate new private key) ---
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private_key value in quotes, keeping the \n sequences.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# --- Admin login: the only email allowed into /admin (create this user in Firebase Auth) ---
ADMIN_EMAIL=you@example.com

# --- Claude API key (console.anthropic.com) for itinerary analysis ---
ANTHROPIC_API_KEY=

# Set to false to hide the hard-coded sample trips once real trips are published.
SHOW_SAMPLE_TRIPS=true

# --- Alerts to you when someone books or registers. Each channel turns on when its keys are set. ---
# The site's public address, used for links inside alerts (optional; otherwise read from the request).
SITE_URL=
# Email through Resend (resend.com). Sent to ALERT_EMAIL_TO, or to ADMIN_EMAIL if that is blank.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=BTT Alerts <alerts@yourdomain.com>
# WhatsApp through Meta's WhatsApp Business Cloud API. Needs an approved message template whose body is a single {{1}}.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=+91XXXXXXXXXX
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
